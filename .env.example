# --- App ---
ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PROJECT_NAME=Halalistic

# --- Database ---
# Async URL for the FastAPI app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://halalistic:halalistic@localhost:5432/halalistic
# Sync URL for Alembic (psycopg/psycopg2) — only used if you switch env.py to sync.
DATABASE_URL_SYNC=postgresql://halalistic:halalistic@localhost:5432/halalistic

# --- Security (used in Stage 3+; placeholders only) ---
SECRET_KEY=change-me-in-prod-use-azure-key-vault
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Azure Blob Storage (Stage 5+) ---
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_PHOTOS=photos
AZURE_BLOB_CONTAINER_DEALS=deals

# --- Stripe (Stage 4) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Google Maps Platform (Stage 5) ---
GOOGLE_MAPS_API_KEY=

# --- OAuth2 / OIDC (Stage 3) ---
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=

# --- CORS (Stage 5) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email provider (Open Item #6 — provider TBD) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@halalistic.example
